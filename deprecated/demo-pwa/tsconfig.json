{
  "extends": "../../tsconfig.base",
  "compilerOptions": {
    "composite": true,
    "types": ["@alwatr/type-helper"],
    "tsBuildInfoFile": ".tsbuildinfo",
    "rootDir": "src",
    "outDir": "build",
    "noEmit": true,
    "plugins": [
      {
        "name": "ts-lit-plugin",
        "strict": true
      }
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": []
}