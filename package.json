{
  "name": "alwatr-nanolib",
  "description": "Necessary library for all ECMAScript (JavaScript/TypeScript) projects.",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com> (https://ali.mihandoost.com)",
  "devDependencies": {
    "@alwatr/eslint-config": "workspace:*",
    "@alwatr/prettier-config": "workspace:*",
    "@alwatr/yarn-upgrade": "workspace:^",
    "@lerna-lite/changed": "^4.7.3",
    "@lerna-lite/cli": "^4.7.3",
    "@lerna-lite/diff": "^4.7.3",
    "@lerna-lite/exec": "^4.7.3",
    "@lerna-lite/publish": "^4.7.3",
    "@lerna-lite/run": "^4.7.3",
    "@lerna-lite/version": "^4.7.3",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "conventional-commits-filter": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-require-extensions": "^0.1.3",
    "jest": "^30.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.16.0",
    "yarn": ">=4.0.0"
  },
  "license": "MPL-2.0",
  "packageManager": "yarn@4.9.4",
  "prettier": "@alwatr/prettier-config",
  "private": true,
  "repository": "https://github.com/Alwatr/nanolib",
  "scripts": {
    "b": "yarn run build",
    "build": "lerna run build",
    "c": "yarn run clean",
    "cb": "yarn run clean && yarn run build",
    "clean": "git add -v . && git clean -d -x -f --exclude=node_modules --exclude='*.env' --exclude=_data --exclude='.pnp*' --exclude=.yarn",
    "f": "yarn run format",
    "format": "yarn run format:prettier && yarn run format:eslint",
    "format:eslint": "yarn run lint --fix",
    "format:prettier": "prettier . --ignore-path .gitignore --write",
    "l": "yarn run lint",
    "lint": "yarn run lint:ts && yarn run lint:es",
    "lint:es": "eslint . --config .eslintrc.json --ext .ts",
    "lint:ts": "lerna run build:ts",
    "publish": "lerna publish from-package",
    "pull": "git pull",
    "release": "lerna version",
    "rl": "yarn run pull && yarn run clean && yarn run build && yarn run lint && yarn run release",
    "rlt": "yarn run release --dry-run",
    "t": "yarn run test",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --enable-source-maps --experimental-vm-modules\" jest --verbose --passWithNoTests",
    "w": "yarn run watch",
    "watch": "lerna run --parallel watch"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
