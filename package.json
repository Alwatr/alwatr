{
  "name": "alwatr-flux",
  "description": "Alwatr Flux empowers your applications with elegant and powerful state management and event handling capabilities. Built on the observable design pattern, Flux provides a lightweight yet robust foundation for managing global signals and states.",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com> (https://ali.mihandoost.com)",
  "devDependencies": {
    "@alwatr/eslint-config": "^5.6.4",
    "@alwatr/prettier-config": "^5.0.5",
    "@alwatr/tsconfig-base": "^6.0.3",
    "@lerna-lite/changed": "^4.9.2",
    "@lerna-lite/cli": "^4.9.2",
    "@lerna-lite/diff": "^4.9.2",
    "@lerna-lite/exec": "^4.9.2",
    "@lerna-lite/publish": "^4.9.2",
    "@lerna-lite/run": "^4.9.2",
    "@lerna-lite/version": "^4.9.2",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "conventional-commits-filter": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-require-extensions": "^0.1.3",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "license": "MPL-2.0",
  "prettier": "@alwatr/prettier-config",
  "private": true,
  "repository": "https://github.com/Alwatr/flux",
  "scripts": {
    "b": "bun run build",
    "build": "lerna run build",
    "c": "bun run clean",
    "cb": "bun run clean && bun run build",
    "clean": "git add -v . && git clean -d -x -f --exclude=node_modules --exclude='*.env' --exclude=_data --exclude='.pnp*' --exclude=.bun",
    "f": "bun run format",
    "format": "bun run format:prettier && bun run format:eslint",
    "format:eslint": "bun run lint --fix",
    "format:prettier": "prettier . --ignore-path .gitignore --write",
    "l": "bun run lint",
    "lint": "bun run lint:ts && bun run lint:es",
    "lint:es": "eslint . --config .eslintrc.json --ext .ts",
    "lint:ts": "lerna run build:ts",
    "publish": "lerna publish from-package",
    "pull": "git pull",
    "release": "lerna version",
    "rl": "bun run pull && bun run clean && bun run build && bun run lint && bun run test && bun run release",
    "rlt": "bun run release --dry-run",
    "t": "bun run test",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --enable-source-maps --experimental-vm-modules\" ALWATR_DEBUG=0 jest --verbose --passWithNoTests",
    "w": "bun run watch",
    "watch": "lerna run --parallel watch"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
