{
  "name": "alwatr-flux",
  "description": "Alwatr Flux empowers your applications with elegant and powerful state management and event handling capabilities. Built on the observable design pattern, Flux provides a lightweight yet robust foundation for managing global signals and states.",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com> (https://ali.mihandoost.com)",
  "devDependencies": {
    "@alwatr/tsconfig-base": "^7.0.0",
    "@lerna-lite/changed": "^4.11.5",
    "@lerna-lite/cli": "^4.11.5",
    "@lerna-lite/diff": "^4.11.5",
    "@lerna-lite/exec": "^4.11.5",
    "@lerna-lite/publish": "^4.11.5",
    "@lerna-lite/run": "^4.11.5",
    "@lerna-lite/version": "^4.11.5",
    "bun-types": "^1.3.10",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "conventional-commits-filter": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MPL-2.0",
  "prettier": "@alwatr/prettier-config",
  "private": true,
  "repository": "https://github.com/Alwatr/flux",
  "scripts": {
    "b": "bun run build",
    "build": "lerna run build",
    "c": "bun run clean",
    "cb": "bun run clean && bun run build",
    "clean": "git add -v . && git clean -d -x -f --exclude=node_modules --exclude='*.env' --exclude=_data --exclude='.pnp*' --exclude=.bun",
    "f": "bun run format",
    "format": "bun run format:prettier && bun run format:es",
    "format:es": "bun run lint --fix",
    "format:prettier": "prettier . --ignore-path .gitignore --write",
    "l": "bun run lint",
    "lint": "bun run lint:ts && bun run lint:es",
    "lint:es": "echo lint-skipped",
    "lint:ts": "lerna run build:ts",
    "publish": "lerna publish from-package",
    "pull": "git pull",
    "release": "lerna version",
    "rl": "bun run pull && bun run clean && bun run build && bun run lint && bun run test && bun run release",
    "rlt": "bun run release --dry-run",
    "t": "bun run test",
    "test": "ALWATR_DEBUG=0 bun test",
    "w": "bun run watch",
    "watch": "lerna run --parallel watch"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
