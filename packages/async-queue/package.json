{
  "name": "@alwatr/async-queue",
  "description": "A queue that executes async tasks in order like mutex and semaphore methodology for javascript and typescript.",
  "version": "5.5.30",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "bugs": "https://github.com/Alwatr/nanolib/issues",
  "dependencies": {
    "@alwatr/flatomise": "workspace:*"
  },
  "devDependencies": {
    "@alwatr/nano-build": "workspace:*",
    "@alwatr/prettier-config": "workspace:*",
    "@alwatr/tsconfig-base": "workspace:*",
    "@alwatr/type-helper": "workspace:*",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
      
    }
  },
  "files": [
    "**/*.{js,mjs,cjs,ts,map,d.ts,html,LEGAL.txt}",
    "README.md",
    "LICENSE",
    "!demo/**/*",
    "!**/*.test.js"
  ],
  "homepage": "https://github.com/Alwatr/nanolib/tree/next/packages/async-queue#readme",
  "keywords": [
    "alwatr",
    "async",
    "async-queue",
    "cross-platform",
    "ECMAScript",
    "esm",
    "javascript",
    "lock",
    "module",
    "mutex",
    "nanolib",
    "node",
    "nodejs",
    "queue",
    "semaphore",
    "semaphore-slim",
    "SemaphoreSlim",
    "spin-lock",
    "SpinLock",
    "typescript",
    "util",
    "utility",
    "utils"
  ],
  "license": "MPL-2.0",
  
  
  "prettier": "@alwatr/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/nanolib",
    "directory": "packages/async-queue"
  },
  "scripts": {
    "b": "bun run build",
    "build": "bun run build:ts && bun run build:es",
    "build:es": "nano-build --preset=module",
    "build:ts": "tsc --build",
    "c": "bun run clean",
    "cb": "bun run clean && bun run build",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "d": "bun run build:es && bun",
    "t": "bun run test",
    "test": "bun test",
    "w": "bun run watch",
    "watch": "bun run watch:ts & bun run watch:es",
    "watch:es": "bun run build:es --watch",
    "watch:ts": "bun run build:ts --watch --preserveWatchOutput"
  },
  "type": "module",
  "types": "./dist/main.d.ts"
}
