{
  "name": "alwatr",
  "description": "Alwatr Ecosystem",
  "version": "5.0.0",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "bugs": "https://github.com/Alwatr/alwatr/issues",
  "dependencies": {
    "@alwatr/flux": "^6.2.0",
    "@alwatr/nanolib": "^9.0.1",
    "@alwatr/nanotron": "^4.10.1",
    "@alwatr/nitrobase": "^7.10.1"
  },
  "devDependencies": {
    "@alwatr/nano-build": "^7.0.1",
    "@alwatr/prettier-config": "^7.0.1",
    "@alwatr/tsconfig-base": "^8.0.0",
    "@alwatr/type-helper": "^8.0.2",
    "typescript": "^6.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.mjs"
    },
    "./nanolib": {
      "types": "./dist/nanolib/nanolib.d.ts",
      "default": "./dist/nanolib/nanolib.mjs"
    },
    "./nanolib/node": {
      "types": "./dist/nanolib/node.d.ts",
      "default": "./dist/nanolib/node.mjs"
    },
    "./nitrobase": {
      "types": "./dist/nitrobase/nitrobase.d.ts",
      "default": "./dist/nitrobase/nitrobase.mjs"
    },
    "./nitrobase/client": {
      "types": "./dist/nitrobase/client.d.ts",
      "default": "./dist/nitrobase/client.mjs"
    },
    "./flux": {
      "types": "./dist/flux.d.ts",
      "default": "./dist/flux.mjs"
    },
    "./nanotron": {
      "types": "./dist/nanotron.d.ts",
      "default": "./dist/nanotron.mjs"
    }
  },
  "files": [
    "**/*.{js,mjs,cjs,ts,map,d.ts,html,LEGAL.txt}",
    "README.md",
    "LICENSE",
    "!demo/**/*",
    "!**/*.test.js"
  ],
  "homepage": "https://github.com/Alwatr/alwatr#readme",
  "keywords": [
    "alwatr"
  ],
  "license": "MPL-2.0",
  "prettier": "@alwatr/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/alwatr",
    "directory": "packages/alwatr"
  },
  "scripts": {
    "b": "yarn run build",
    "build": "yarn run build:ts && yarn run build:es",
    "build:es": "nano-build --preset=module3",
    "build:ts": "tsc --build",
    "c": "yarn run clean",
    "cb": "yarn run clean && yarn run build",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "d": "yarn run build:es && yarn node --enable-source-maps --trace-warnings",
    "t": "yarn run test",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --enable-source-maps --experimental-vm-modules\" jest",
    "w": "yarn run watch",
    "watch": "yarn run watch:ts & yarn run watch:es",
    "watch:es": "yarn run build:es --watch",
    "watch:ts": "yarn run build:ts --watch --preserveWatchOutput"
  },
  "sideEffects": false,
  "type": "module"
}
