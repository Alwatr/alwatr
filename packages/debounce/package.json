{
  "name": "@alwatr/debounce",
  "description": "A powerful, modern, and type-safe debouncer utility designed for high-performance applications. It's framework-agnostic, works seamlessly in both Node.js and browsers, and provides a rich API for fine-grained control over function execution.",
  "version": "1.1.20",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "bugs": "https://github.com/Alwatr/nanolib/issues",
  "devDependencies": {
    "@alwatr/nano-build": "workspace:*",
    "@alwatr/prettier-config": "workspace:*",
    "@alwatr/tsconfig-base": "workspace:*",
    "@alwatr/type-helper": "workspace:*",
    "@types/node": "^24.12.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    }
  },
  "files": [
    "**/*.{js,mjs,cjs,map,d.ts,html,md,LEGAL.txt}",
    "LICENSE",
    "!demo/**/*",
    "!**/*.test.js"
  ],
  "homepage": "https://github.com/Alwatr/nanolib/tree/next/packages/debounce#readme",
  "keywords": [
    "alwatr",
    "browser",
    "cross-platform",
    "debounce",
    "debouncing",
    "esm",
    "framework-agnostic",
    "javascript",
    "leading",
    "lifecycle",
    "memory-leak",
    "module",
    "nanolib",
    "node",
    "nodejs",
    "trailing",
    "tree-shakable",
    "type-safe",
    "typescript",
    "universal",
    "util",
    "utility"
  ],
  "license": "MPL-2.0",
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "prettier": "@alwatr/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/nanolib",
    "directory": "packages/debounce"
  },
  "scripts": {
    "b": "bun run build",
    "build": "bun run build:ts && bun run build:es",
    "build:es": "nano-build --preset=module",
    "build:ts": "tsc --build",
    "c": "bun run clean",
    "cb": "bun run clean && bun run build",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "d": "bun run build:es && bun --enable-source-maps --trace-warnings",
    "w": "bun run watch",
    "watch": "bun run watch:ts & bun run watch:es",
    "watch:es": "bun run build:es --watch",
    "watch:ts": "bun run build:ts --watch --preserveWatchOutput"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/main.d.ts"
}
