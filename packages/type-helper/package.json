{
  "name": "@alwatr/type-helper",
  "description": "Collection of useful typescript type helpers.",
  "version": "7.0.1",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "bugs": "https://github.com/Alwatr/nanolib/issues",
  "devDependencies": {
    "@alwatr/prettier-config": "workspace:*",
    "typescript": "^5.9.3"
  },
  "files": [
    "**/*.{js,mjs,cjs,map,d.ts,html,md,LEGAL.txt}",
    "LICENSE",
    "!demo/**/*",
    "!**/*.test.js"
  ],
  "homepage": "https://github.com/Alwatr/nanolib/tree/next/packages/type-helper#readme",
  "keywords": [
    "alwatr",
    "nanolib",
    "type",
    "type-helper",
    "types",
    "typescript",
    "util",
    "utility",
    "utils"
  ],
  "license": "MPL-2.0",
  "main": "",
  "prettier": "@alwatr/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/nanolib",
    "directory": "packages/type-helper"
  },
  "scripts": {
    "b": "bun run build",
    "build": "bun run build:ts && bun run build:es",
    "build:es": "echo skip build:es",
    "build:ts": "echo skip build:ts",
    "c": "bun run clean",
    "cb": "bun run clean && bun run build",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "d": "bun run build:es && bun --enable-source-maps --trace-warnings",
    "w": "bun run watch",
    "watch": "bun run watch:ts & bun run watch:es",
    "watch:es": "bun run build:es --watch",
    "watch:ts": "bun run build:ts --watch --preserveWatchOutput"
  },
  "sideEffects": false,
  "type": "module",
  "types": "types.d.ts"
}
