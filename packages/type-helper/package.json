{
  "name": "@alwatr/type-helper",
  "description": "Collection of useful typescript type helpers.",
  "version": "6.1.5",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "bugs": "https://github.com/Alwatr/nanolib/issues",
  "devDependencies": {
    "@alwatr/prettier-config": "workspace:*",
    "typescript": "^5.9.3"
  },
  "files": [
    "**/*.{js,mjs,cjs,map,d.ts,html,md,LEGAL.txt}",
    "LICENSE",
    "!demo/**/*",
    "!**/*.test.js"
  ],
  "homepage": "https://github.com/Alwatr/nanolib/tree/next/packages/type-helper#readme",
  "keywords": [
    "alwatr",
    "nanolib",
    "type",
    "type-helper",
    "types",
    "typescript",
    "util",
    "utility",
    "utils"
  ],
  "license": "MPL-2.0",
  "main": "",
  "prettier": "@alwatr/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/nanolib",
    "directory": "packages/type-helper"
  },
  "scripts": {
    "b": "yarn run build",
    "build": "yarn run build:ts && yarn run build:es",
    "build:es": "echo skip build:es",
    "build:ts": "echo skip build:ts",
    "c": "yarn run clean",
    "cb": "yarn run clean && yarn run build",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "d": "yarn run build:es && yarn node --enable-source-maps --trace-warnings",
    "w": "yarn run watch",
    "watch": "yarn run watch:ts & yarn run watch:es",
    "watch:es": "yarn run build:es --watch",
    "watch:ts": "yarn run build:ts --watch --preserveWatchOutput"
  },
  "sideEffects": false,
  "type": "module",
  "types": "types.d.ts"
}
