{
  "name": "alwatr",
  "version": "5.0.0",
  "description": "Alwatr Ecosystem",
  "license": "MPL-2.0",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/alwatr",
    "directory": "packages/alwatr"
  },
  "homepage": "https://github.com/Alwatr/alwatr#readme",
  "bugs": "https://github.com/Alwatr/alwatr/issues",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.mjs"
    },
    "./nanolib": {
      "types": "./dist/nanolib/nanolib.d.ts",
      "default": "./dist/nanolib/nanolib.mjs"
    },
    "./nanolib/node": {
      "types": "./dist/nanolib/node.d.ts",
      "default": "./dist/nanolib/node.mjs"
    },
    "./nitrobase": {
      "types": "./dist/nitrobase/nitrobase.d.ts",
      "default": "./dist/nitrobase/nitrobase.mjs"
    },
    "./nitrobase/client": {
      "types": "./dist/nitrobase/client.d.ts",
      "default": "./dist/nitrobase/client.mjs"
    },
    "./flux": {
      "types": "./dist/flux.d.ts",
      "default": "./dist/flux.mjs"
    },
    "./nanotron": {
      "types": "./dist/nanotron.d.ts",
      "default": "./dist/nanotron.mjs"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@alwatr/flux": "^6.1.0",
    "@alwatr/nanolib": "workspace:*",
    "@alwatr/nanotron": "workspace:*",
    "@alwatr/nitrobase": "workspace:*"
  },
  "devDependencies": {
    "@alwatr/nano-build": "workspace:*",
    "@alwatr/tsconfig-base": "workspace:*",
    "@alwatr/type-helper": "workspace:*",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "b": "bun run build",
    "build": "bun run build:ts && bun run build:es",
    "build:es": "nano-build --preset=module src/**/*.ts",
    "build:ts": "tsc --build",
    "c": "bun run clean",
    "cb": "bun run clean && bun run build",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "d": "bun run build:es && bun",
    "t": "bun run test",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --enable-source-maps --experimental-vm-modules\" jest",
    "w": "bun run watch",
    "watch": "bun run watch:ts & bun run watch:es",
    "watch:es": "bun run build:es --watch",
    "watch:ts": "bun run build:ts --watch --preserveWatchOutput"
  },
  "files": [
    "**/*.{js,mjs,cjs,ts,map,d.ts,html,LEGAL.txt}",
    "README.md",
    "LICENSE",
    "!demo/**/*",
    "!**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "alwatr"
  ]
}
