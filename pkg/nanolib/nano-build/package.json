{
  "name": "@alwatr/nano-build",
  "version": "7.0.1",
  "description": "Lightweight, zero-config Bun-based build CLI for JavaScript, TypeScript, and ECMAScript libraries. Minimal dependencies, fast builds, and sensible presets for multiple project types.",
  "license": "MPL-2.0",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "repository": {
    "directory": "packages/nano-build",
    "type": "git",
    "url": "https://github.com/Alwatr/nanolib"
  },
  "homepage": "https://github.com/Alwatr/nanolib/tree/next/packages/nano-build#readme",
  "bugs": "https://github.com/Alwatr/nanolib/issues",
  "bin": "./cli.sh",
  "sideEffects": false,
  "files": [
    "**/*.{sh,js,mjs,cjs,ts,map,d.ts,html,LEGAL.txt}",
    "README.md",
    "LICENSE",
    "!demo/**/*",
    "!**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "alwatr",
    "browser",
    "build",
    "bun",
    "bundle",
    "cross-platform",
    "ECMAScript",
    "esbuild",
    "esm",
    "javascript",
    "module",
    "nanolib",
    "node",
    "nodejs",
    "typescript",
    "util",
    "utility",
    "utils"
  ],
  "types": "./global.d.ts"
}
