{
  "name": "@alwatr/nitrobase-user-management",
  "description": "",
  "version": "7.10.1",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "bugs": "https://github.com/Alwatr/nitrobase/issues",
  "dependencies": {
    "@alwatr/logger": "^6.0.15",
    "@alwatr/nitrobase-engine": "workspace:^",
    "@alwatr/nitrobase-reference": "workspace:^",
    "@alwatr/nitrobase-types": "workspace:^",
    "@alwatr/node-fs": "^5.5.29",
    "@alwatr/type-helper": "^7.0.0"
  },
  "devDependencies": {
    "@alwatr/nanolib": "^7.3.4",
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.mjs",
      "require": "./dist/main.cjs"
    }
  },
  "files": [
    "**/*.{js,mjs,cjs,map,d.ts,html,md}",
    "!demo/**/*"
  ],
  "homepage": "https://github.com/Alwatr/nitrobase/tree/next/packages/user-management#readme",
  "keywords": [
    "alwatr",
    "data",
    "data-storage",
    "database",
    "esm",
    "file",
    "json",
    "no-sql",
    "nosql",
    "storage",
    "typescript",
    "user",
    "user-management"
  ],
  "license": "MPL-2.0",
  "main": "./dist/main.cjs",
  "module": "./dist/main.mjs",
  "prettier": "@alwatr/nanolib/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/nitrobase",
    "directory": "packages/user-management"
  },
  "scripts": {
    "b": "bun run build",
    "build": "bun run build:ts && bun run build:es",
    "build:es": "nano-build --preset=module",
    "build:ts": "tsc --build",
    "c": "bun run clean",
    "cb": "bun run clean && bun run build",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "d": "bun run build:es && bun node",
    "w": "bun run watch",
    "watch": "bun run watch:ts & bun run watch:es",
    "watch:es": "bun run build:es --watch",
    "watch:ts": "bun run build:ts --watch --preserveWatchOutput"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/main.d.ts"
}
