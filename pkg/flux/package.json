{
  "name": "@alwatr/flux",
  "version": "9.33.0",
  "description": "UI and reactive library bundle for ECMAScript (JavaScript/TypeScript) projects — signals, actions, directives, and storage.",
  "license": "MPL-2.0",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com> (https://ali.mihandoost.com)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alwatr/alwatr",
    "directory": "pkg/flux"
  },
  "homepage": "https://github.com/Alwatr/alwatr/tree/next/pkg/flux#readme",
  "bugs": "https://github.com/Alwatr/alwatr/issues",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@alwatr/action": "workspace:*",
    "@alwatr/bind": "workspace:*",
    "@alwatr/directive": "workspace:*",
    "@alwatr/embedded-data": "workspace:*",
    "@alwatr/fsm": "workspace:*",
    "@alwatr/keyboard-shortcut": "workspace:*",
    "@alwatr/local-storage": "workspace:*",
    "@alwatr/page-ready": "workspace:*",
    "@alwatr/render-state": "workspace:*",
    "@alwatr/session-storage": "workspace:*",
    "@alwatr/signal": "workspace:*",
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "@alwatr/nano-build": "workspace:*",
    "@alwatr/standard": "workspace:*",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "b": "bun run build",
    "build": "bun run build:ts && bun run build:es",
    "build:es": "nano-build --preset=module src/main.ts",
    "build:ts": "tsc --build",
    "cl": "bun run clean",
    "clean": "rm -rfv dist *.tsbuildinfo",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src/ --ext .ts",
    "t": "bun run test",
    "test": "ALWATR_DEBUG=0 bun test",
    "w": "bun run watch",
    "watch": "bun run watch:ts & bun run watch:es",
    "watch:es": "bun run build:es --watch",
    "watch:ts": "bun run build:ts --watch --preserveWatchOutput"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "alwatr",
    "action",
    "directive",
    "dom",
    "ECMAScript",
    "esm",
    "flux",
    "javascript",
    "local-storage",
    "module",
    "nanolib",
    "reactive",
    "render-state",
    "session-storage",
    "signal",
    "typescript",
    "ui",
    "unidirectional-data-flow"
  ]
}
