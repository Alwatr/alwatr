{
  "name": "@alwatr/loom",
  "version": "0.1.0",
  "description": "A tiny, zero-dependency static site generator core that renders TSX templates to HTML strings — no React, no virtual DOM.",
  "private": true,
  "license": "MPL-2.0",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "type": "module",
  "homepage": "https://github.com/alimd/passage-app#readme",
  "bugs": "https://github.com/alimd/passage-app/issues",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "devDependencies": {
    "@alwatr/nano-build": "^9.38.1",
    "@alwatr/standard": "^9.38.2",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "b": "bun run build",
    "build": "bun run build:ts && bun run build:js",
    "build:js": "nano-build --preset=bun-service --packages=external src/*.ts",
    "build:ts": "tsc --build",
    "cb": "bun run clean && bun run build",
    "clean": "rm -rfv dist tsconfig.tsbuildinfo",
    "l": "bun run lint",
    "lint": "tsc --noEmit",
    "t": "bun run test",
    "test": "ALWATR_DEBUG=0 bun test"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "bun",
    "jsx",
    "ssg",
    "static-site-generator",
    "tsx"
  ]
}
