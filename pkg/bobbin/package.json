{
  "name": "@alwatr/bobbin",
  "version": "0.1.0",
  "description": "A declarative, build-time data pipeline for fetching, validating, and caching external APIs into JSON files.",
  "private": true,
  "license": "MPL-2.0",
  "author": "S. Ali Mihandoost <ali.mihandoost@gmail.com>",
  "type": "module",
  "homepage": "https://github.com/alimd/passage-app#readme",
  "bugs": "https://github.com/alimd/passage-app/issues",
  "keywords": [
    "data-pipeline",
    "cache",
    "build-time",
    "fetch",
    "schema-validation",
    "bun"
  ],
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "@alwatr/nano-build": "^9.38.1",
    "@alwatr/standard": "^9.38.2",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "b": "bun run build",
    "build": "bun run build:ts && bun run build:js",
    "build:js": "nano-build --preset=bun-service --packages=external src/*.ts",
    "build:ts": "tsc --build",
    "cb": "bun run clean && bun run build",
    "clean": "rm -rfv dist tsconfig.tsbuildinfo",
    "l": "bun run lint",
    "lint": "tsc --noEmit",
    "t": "bun run test",
    "test": "ALWATR_DEBUG=0 bun test"
  }
}
